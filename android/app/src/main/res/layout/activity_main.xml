<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

    </androidx.camera.view.PreviewView>

    <ch.michioxd.sensorithm.ZoneOverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView" />

    <TextView
        android:id="@+id/tvWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sensorithm"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView" />

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disconnected"
        android:textColor="@android:color/holo_red_light"
        android:textStyle="bold"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Server IP"
                android:inputType="textUri"
                android:text="127.0.0.1"
                android:textColor="@android:color/white"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="Port"
                android:inputType="number"
                android:text="4420"
                android:textColor="@android:color/white"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Connect" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <CheckBox
                android:id="@+id/cbAutoReconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto Reconnect"
                android:textColor="@android:color/white" />
            
            <CheckBox
                android:id="@+id/cbAutoConnectOnStartup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto connect on startup"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChangeCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Camera" />

            <Button
                android:id="@+id/btnChangeRes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Res" />

            <Button
                android:id="@+id/btnChangeFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="FPS" />

            <Button
                android:id="@+id/btnRestartCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Restart" />
        </LinearLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="1">

            <TableRow>

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Size X"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbSizeX"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="50"
                    android:progress="15" />

                <TextView
                    android:id="@+id/tvSizeXValue"
                    android:layout_marginStart="8dp"
                    android:text="15%"
                    android:textColor="@android:color/white" />
            </TableRow>

            <TableRow android:layout_marginTop="8dp">

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Size Y"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbSizeY"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="50"
                    android:progress="5" />

                <TextView
                    android:id="@+id/tvSizeYValue"
                    android:layout_marginStart="8dp"
                    android:text="5%"
                    android:textColor="@android:color/white" />
            </TableRow>

            <TableRow android:layout_marginTop="8dp">

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Spacing"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbSpacing"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/tvSpacingValue"
                    android:layout_marginStart="8dp"
                    android:text="10%"
                    android:textColor="@android:color/white" />
            </TableRow>

            <TableRow android:layout_marginTop="8dp">

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Angle"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbAngle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="360"
                    android:progress="180" />

                <TextView
                    android:id="@+id/tvAngleValue"
                    android:layout_marginStart="8dp"
                    android:text="180"
                    android:textColor="@android:color/white" />
            </TableRow>

            <TableRow android:layout_marginTop="8dp">

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Exposure"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbExposure"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:id="@+id/tvExposureValue"
                    android:layout_marginStart="8dp"
                    android:text="50"
                    android:textColor="@android:color/white" />
            </TableRow>

            <TableRow android:layout_marginTop="8dp">

                <TextView
                    android:layout_marginEnd="8dp"
                    android:text="Threshold"
                    android:textColor="@android:color/white" />

                <SeekBar
                    android:id="@+id/sbThreshold"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="30" />

                <TextView
                    android:id="@+id/tvThresholdValue"
                    android:layout_marginStart="8dp"
                    android:text="30"
                    android:textColor="@android:color/white" />
            </TableRow>
        </TableLayout>

        <Button
            android:id="@+id/btnRecalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recalibrate" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>